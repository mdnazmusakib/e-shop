<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Product - Cartify Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-slate-50 text-slate-800 antialiased min-h-screen">
    <header class="bg-white border-b border-slate-200">
        <nav class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
            <h3 class="font-serif text-2xl font-bold tracking-tight text-blue-900">Cartify</h3>
            <div class="flex gap-5 text-sm">
                <!-- <a href="/shop">Shop</a> -->
                <a class="text-red-700 hover:underline" href="/owners/logout">Logout</a>
            </div>
        </nav>
    </header>

    <% if(success.length>0){ %>
        <div class="fixed top-4 inset-x-0 mx-auto w-fit max-w-[90%] z-50 px-5 py-3 rounded border border-green-300 bg-green-50 shadow">
            <span class="text-green-800 text-sm">
                <%= success %>
            </span>
        </div>
    <% } %>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 lg:py-12">
        <div class="grid grid-cols-1 lg:grid-cols-[14rem_1fr] gap-6 lg:gap-10">

            <aside class="lg:border-r lg:border-slate-200 lg:pr-6">
                <div class="flex flex-row flex-wrap gap-x-6 gap-y-2 lg:flex-col lg:gap-0 text-sm">
                    <a class="block w-fit lg:mb-2 hover:text-blue-900 hover:underline" href="/owners/shop">All Products</a>
                    <a class="block w-fit lg:mb-2 hover:text-blue-900 hover:underline" href="/owners/admin">Create new product</a>
                </div>
            </aside>

            <main class="bg-white border border-slate-200 rounded-md shadow-sm p-6 sm:p-8">
                <h2 class="font-serif text-2xl font-bold text-slate-900 mb-6">Create New Product</h2>
                <form autocomplete="off" action="/products/create" method="post" enctype="multipart/form-data">
                    <div class="mb-8">
                        <h3 class="font-serif text-lg font-semibold mb-3 pb-2 border-b border-slate-200">Product Details</h3>
                        <div class="mb-4">
                            <label class="block mb-2 text-sm font-medium">Product Image</label>
                            <input name="image" type="file" value="Select File"
                                class="block w-full text-sm text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded file:border file:border-slate-300 file:bg-slate-100 file:text-slate-800 hover:file:bg-slate-200">
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <input name="name" type="text" placeholder="Product Name" aria-label="Product Name"
                                class="border border-slate-300 px-3 py-2.5 rounded w-full focus:outline-none focus:border-blue-900 focus:ring-1 focus:ring-blue-900">
                            <input name="price" type="text" placeholder="Product Price" aria-label="Product Price"
                                class="border border-slate-300 px-3 py-2.5 rounded w-full focus:outline-none focus:border-blue-900 focus:ring-1 focus:ring-blue-900">
                            <input name="discount" type="text" placeholder="Discount Price" aria-label="Discount Price"
                                class="border border-slate-300 px-3 py-2.5 rounded w-full focus:outline-none focus:border-blue-900 focus:ring-1 focus:ring-blue-900">
                        </div>
                    </div>

                    <div>
                        <h3 class="font-serif text-lg font-semibold mb-3 pb-2 border-b border-slate-200">Panel Details</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <input name="bgcolor" type="text" placeholder="Background Color" aria-label="Background Color"
                                class="border border-slate-300 px-3 py-2.5 rounded w-full focus:outline-none focus:border-blue-900 focus:ring-1 focus:ring-blue-900">
                            <input name="panelcolor" type="text" placeholder="Panel Color" aria-label="Panel Color"
                                class="border border-slate-300 px-3 py-2.5 rounded w-full focus:outline-none focus:border-blue-900 focus:ring-1 focus:ring-blue-900">
                            <input name="textcolor" type="text" placeholder="Text Color" aria-label="Text Color"
                                class="border border-slate-300 px-3 py-2.5 rounded w-full focus:outline-none focus:border-blue-900 focus:ring-1 focus:ring-blue-900">
                        </div>
                    </div>
                    <input class="w-full sm:w-auto px-6 py-2.5 rounded mt-6 bg-blue-900 text-white cursor-pointer hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:ring-offset-2"
                        type="submit" value="Create New Product">
                </form>
            </main>

        </div>
    </div>
</body>

</html>
