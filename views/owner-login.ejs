<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cartify - Admin Login</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">
    <header class="bg-white border-b border-slate-200">
        <nav class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
            <h3 class="font-serif text-2xl font-bold tracking-tight text-blue-900">Cartify</h3>
            <div class="flex gap-5 text-sm">
                <a class="text-blue-900 font-medium hover:underline" href="/">User Login</a>
            </div>
        </nav>
    </header>

    <% if(error.length>0){ %>
        <div class="fixed top-4 inset-x-0 mx-auto w-fit max-w-[90%] z-50 px-5 py-3 rounded border border-red-300 bg-red-50 shadow">
            <span class="text-red-800 text-sm">
                <%= error %>
            </span>
        </div>
    <% } %>

    <main class="flex-1 flex items-center justify-center px-4 sm:px-6 py-10">
        <section class="w-full max-w-md bg-white border border-slate-200 rounded-md shadow-sm p-6 sm:p-10">
            <h4 class="font-serif text-2xl capitalize text-slate-900 mb-6">Admin Access</h4>
            <form action="/owners/login" method="post">
                <input
                    class="block w-full px-3 py-2.5 mb-4 bg-white border border-slate-300 rounded focus:outline-none focus:border-blue-900 focus:ring-1 focus:ring-blue-900"
                    type="email" placeholder="Email" aria-label="Email" name="email">
                <input
                    class="block w-full px-3 py-2.5 mb-4 bg-white border border-slate-300 rounded focus:outline-none focus:border-blue-900 focus:ring-1 focus:ring-blue-900"
                    type="password" placeholder="Password" aria-label="Password" name="password">
                <input
                    class="w-full px-6 py-2.5 mt-2 bg-blue-900 text-white rounded cursor-pointer hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:ring-offset-2"
                    type="submit" value="Login">
            </form>
        </section>
    </main>
</body>

</html>
