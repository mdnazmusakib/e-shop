<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Account - Scatch</title>

    <link
        href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
        rel="stylesheet"
    />

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>


<body class="bg-gray-100 font-['helvetica_now_display']">
    <nav class="w-full flex justify-between px-5 py-3">
        <h3 class="text-xl">Cartify</h3>
        <div class="flex gap-5">
            <a href="/shop">Shop</a>
            <a href="/cart">Cart</a>
            <a href="/account">My Account</a>
            <a class="text-red-600" href="/users/logout">Logout</a>
        </div>
    </nav>
    <main class="min-h-screen px-5 sm:px-10 lg:px-20 py-10">
        <div class="mb-8">
            <h1 class="text-3xl sm:text-4xl font-semibold">
                My Account
            </h1>
            <p class="text-gray-500 mt-2">
                Manage your profile and view your orders.
            </p>
        </div>
        <% if (success && success.length > 0) { %>
            <div
                class="mb-6 px-5 py-4 bg-green-50 border border-green-200 text-green-700 rounded-lg"
            >
                <%= success[0] %>
            </div>
        <% } %>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-1">
                <div class="bg-white rounded-xl shadow-sm p-6">
                    <div class="flex flex-col items-center text-center">
                        <% if (user.picture) { %>
                            <img
                                src="<%= user.picture %>"
                                alt="<%= user.fullname %>"
                                class="w-28 h-28 rounded-full object-cover border-4 border-gray-100"
                            >
                        <% } else { %>
                            <div
                                class="w-28 h-28 rounded-full bg-gray-200 flex items-center justify-center"
                            >
                                <i class="ri-user-3-line text-5xl text-gray-500"></i>

                            </div>
                        <% } %>
                        <h2 class="text-xl font-semibold mt-5">
                            <%= user.fullname %>
                        </h2>
                        <p class="text-gray-500 mt-1 break-all">
                            <%= user.email %>
                        </p>
                    </div>
                    <div class="w-full h-px bg-gray-200 my-6"></div>
                    <div class="space-y-5">
                        <div class="flex items-start gap-4">
                            <div
                                class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center shrink-0"
                            >
                                <i class="ri-user-line text-xl"></i>
                            </div>
                            <div>
                                <p class="text-sm text-gray-500">
                                    Full Name
                                </p>
                                <p class="font-medium mt-1">
                                    <%= user.fullname %>
                                </p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <div
                                class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center shrink-0"
                            >
                                <i class="ri-mail-line text-xl"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="text-sm text-gray-500">
                                    Email
                                </p>
                                <p class="font-medium mt-1 break-all">
                                    <%= user.email %>
                                </p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <div
                                class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center shrink-0"
                            >
                                <i class="ri-phone-line text-xl"></i>
                            </div>
                            <div>
                                <p class="text-sm text-gray-500">
                                    Contact
                                </p>
                                <p class="font-medium mt-1">
                                    <%= user.contact || 'Not added' %>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="lg:col-span-2">
                <div class="bg-white rounded-xl shadow-sm p-6">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="text-2xl font-semibold">
                                My Orders
                            </h2>
                            <p class="text-gray-500 text-sm mt-1">
                                Your purchased products
                            </p>
                        </div>
                        <div
                            class="px-4 py-2 rounded-full bg-gray-100 text-sm font-medium"
                        >
                            <%= user.orders.length %>
                            <%= user.orders.length === 1 ? 'Order' : 'Orders' %>
                        </div>
                    </div>
                    <% if (user.orders.length === 0) { %>
                        <div class="py-16 text-center">
                            <div
                                class="w-20 h-20 mx-auto rounded-full bg-gray-100 flex items-center justify-center"
                            >
                                <i
                                    class="ri-shopping-bag-3-line text-4xl text-gray-400"
                                ></i>
                            </div>
                            <h3 class="text-xl font-semibold mt-5">
                                No orders yet
                            </h3>
                            <p class="text-gray-500 mt-2">
                                Your purchased products will appear here.
                            </p>
                            <a
                                href="/shop"
                                class="inline-block mt-6 px-6 py-3 bg-black text-white rounded-lg hover:bg-gray-800 transition"
                            >
                                Start Shopping
                            </a>
                        </div>
                    <% } else { %>
                        <div class="space-y-5">
                            <% user.orders.forEach(function(product, index) { %>
                                <div
                                    class="border border-gray-200 rounded-xl overflow-hidden"
                                >
                                    <div
                                        class="flex flex-col sm:flex-row"
                                    >
                                        <div
                                            class="w-full sm:w-40 h-40 bg-gray-100 flex items-center justify-center shrink-0"
                                        >
                                            <img
                                                src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                                alt="<%= product.name %>"
                                                class="w-32 h-32 object-contain"
                                            >
                                        </div>
                                        <div class="flex-1 p-5">
                                            <div
                                                class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3"
                                            >
                                                <div>
                                                    <p class="text-xs text-gray-400 uppercase tracking-wider">
                                                        Order #<%= index + 1 %>
                                                    </p>
                                                    <h3
                                                        class="text-lg font-semibold mt-1"
                                                    >
                                                        <%= product.name %>
                                                    </h3>
                                                </div>
                                                <span
                                                    class="inline-flex w-fit px-3 py-1 rounded-full bg-green-50 text-green-600 text-sm font-medium"
                                                >
                                                    Purchased
                                                </span>
                                            </div>
                                            <div
                                                class="flex items-center gap-3 mt-5"
                                            >
                                                <span
                                                    class="text-lg font-semibold"
                                                >
                                                    ৳ <%= product.price %>
                                                </span>
                                                <% if (Number(product.discount || 0) > 0) { %>
                                                    <span
                                                        class="text-red-500 font-medium"
                                                    >
                                                        -₹ <%= product.discount %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <p class="text-sm text-gray-500 mt-2">
                                                Paid:
                                                <span class="font-medium text-gray-800">
                                                    ₹
                                                    <%= Number(product.price || 0) -
                                                        Number(product.discount || 0) %>
                                                </span>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
</body>

</html>