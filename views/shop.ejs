<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop - Cartify</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-slate-50 text-slate-800 antialiased min-h-screen">
    <header class="bg-white border-b border-slate-200">
        <nav class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <h3 class="font-serif text-2xl font-bold tracking-tight text-blue-900">Cartify</h3>
            <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
                <a class="hover:text-blue-900 hover:underline" href="/shop">Shop</a>
                <a class="hover:text-blue-900 hover:underline" href="/cart">Cart</a>
                <a class="hover:text-blue-900 hover:underline" href="/account">My Account</a>
                <a class="text-red-700 hover:underline" href="/users/logout">Logout</a>
            </div>
        </nav>
    </header>

    <% if(success.length>0){ %>
        <div class="fixed top-4 inset-x-0 mx-auto w-fit max-w-[90%] z-50 px-5 py-3 rounded border border-green-300 bg-green-50 shadow">
            <span class="text-green-800 text-sm">
                <%= success %>
            </span>
        </div>
    <% } %>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 lg:py-12">
        <div class="grid grid-cols-1 lg:grid-cols-[14rem_1fr] gap-8 lg:gap-12">

            <aside class="lg:border-r lg:border-slate-200 lg:pr-6">
                <div class="flex items-center gap-2 text-sm">
                    <h3 class="font-medium">Sort by</h3>
                    <form action="/shop">
                        <select class="border border-slate-300 bg-white rounded px-2 py-1 focus:outline-none focus:border-blue-900"
                            name="sortby" id="" onchange="this.form.submit()">
                            <option value="popular">Popular</option>
                            <option value="newest">Newest</option>
                        </select>
                    </form>
                </div>
                <div class="flex flex-row flex-wrap gap-x-6 gap-y-2 lg:flex-col lg:gap-0 mt-6 lg:mt-10 text-sm">
                    <a class="block w-fit lg:mb-2 hover:text-blue-900 hover:underline" href="">New Collection</a>
                    <a class="block w-fit lg:mb-2 hover:text-blue-900 hover:underline" href="/shop">All Products</a>
                    <a class="block w-fit lg:mb-2 hover:text-blue-900 hover:underline" href="">Discounted Products</a>
                </div>
                <div class="flex flex-row flex-wrap gap-x-6 gap-y-2 lg:flex-col lg:gap-0 mt-4 lg:mt-10 pt-4 lg:pt-0 border-t border-slate-200 lg:border-0 text-sm">
                    <a class="block w-fit lg:mb-2 font-medium" href="">Filter by :</a>
                    <a class="block w-fit lg:mb-2 hover:text-blue-900 hover:underline" href="/shop">Availability</a>
                    <a class="block w-fit lg:mb-2 hover:text-blue-900 hover:underline" href="">Discount</a>
                </div>
            </aside>

            <section>
                <h1 class="font-serif text-3xl text-slate-900 mb-6">Shop</h1>
                <% if (products.length === 0) { %>
                    <div class="bg-white border border-slate-200 rounded-md p-10 text-center text-slate-500">
                        No products are available yet.
                    </div>
                <% } else { %>
                <div class="grid grid-cols-1 min-[480px]:grid-cols-2 xl:grid-cols-3 gap-6">
                    <% products.forEach(function(product){ %>
                        <div class="bg-white border border-slate-200 rounded-md shadow-sm overflow-hidden">
                            <div class="w-full h-56 flex items-center justify-center"
                                style="background-color: <%= product.bgcolor %>">
                                <img class="h-48 max-w-full object-contain" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                    alt="<%= product.name %>">
                            </div>
                            <div class="flex justify-between items-center gap-3 px-4 py-4"
                                style="background-color: <%= product.panelcolor %>; color: <%= product.textcolor %>">
                                <div class="min-w-0">
                                    <h3 class="font-medium truncate">
                                        <%= product.name %>
                                    </h3>
                                    <h4 class="text-sm">৳ <%= product.price %>
                                    </h4>
                                </div>
                                <a class="shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-white text-slate-900 border border-slate-300 hover:bg-slate-100"
                                    href="/addtocart/<%=product._id%>" title="Add to cart">
                                    <i class="ri-add-line"></i>
                                </a>
                            </div>
                        </div>
                    <% }) %>
                </div>
                <% } %>
            </section>

        </div>
    </main>
</body>

</html>
